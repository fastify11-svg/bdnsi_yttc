{
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/pre_command_gate.js",
            "timeout": 10
          }
        ]
      }
    ]
  },

  "audit-logger": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/post_command_audit.js",
            "timeout": 5
          }
        ]
      }
    ]
  },

  "context-reminder": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node .agents/hooks/pre_invocation_reminder.js",
        "timeout": 5
      }
    ]
  },

  "stop-guard": {
    "Stop": [
      {
        "type": "command",
        "command": "node .agents/hooks/stop_guard.js",
        "timeout": 5
      }
    ]
  }
}
